{
  "parameters": {
    "nsgPolicyEffect": {
      "type": "String",
      "metadata": {
        "displayName": "NSG Policy Effect",
        "description": "The effect determines what happens when the policy rule is evaluated to match."
      },
      "allowedValues": [
        "Audit",
        "Deny",
        "Disabled"
      ],
      "defaultValue": "Audit"
    },
    "restrictedInboundPorts": {
      "type": "Array",
      "metadata": {
        "displayName": "Restricted inbound ports",
        "description": "List of inbound ports to restrict in the Network Security Group (SSH, FTP, RDP, SQL, and WinRM HTTP/HTTPS)."
      },
      "defaultValue": [
        "21",
        "22",
        "1433",
        "3389",
        "5985",
        "5986"
      ]
    }
  }
}